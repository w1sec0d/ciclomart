# CicloMart Frontend — environment variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

# Base URL of the CicloMart backend API
VITE_API_URL=http://localhost:3001

# MercadoPago integration (the matching backend credentials live in the backend .env)
# The public key is safe to expose in the browser.
VITE_MP_PUBLIC_KEY=
VITE_MP_CLIENT_ID=
VITE_MP_REDIRECT_URI=
